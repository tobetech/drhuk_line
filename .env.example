LINE_CHANNEL_SECRET=ใส่_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=ใส่_channel_access_token_แบบ_long-lived
PORT=3000

# --- ดูฤกษ์ยามฉีเหมิน (เรียกเซิร์ฟเวอร์กลาง) ---
# ไม่ใส่ QIMEN_LICENSE_KEY = ปิดฟีเจอร์นี้
QIMEN_GATEWAY_URL=https://qimen.tobe-tech.com
QIMEN_LICENSE_KEY=
QIMEN_MACHINE_ID=line-bot

# ลิงก์หน้าเว็บดูฤกษ์ยามเพิ่ม (https) ส่งให้ผู้ใช้เมื่อใช้สิทธิ์ฟรีวันละ 1 ครั้งแล้ว (ว่าง = บอกว่าเร็วๆ นี้)
QIMEN_WEB_URL=

# --- ชำระเงินใน LINE (ปิดไว้ ไม่ใช้งานแล้ว โค้ดยังอยู่) ---
# เปิดใช้เมื่อ license ของบอทที่ gateway ตั้ง price_qr เท่ากับราคานี้ และมี Ksher พร้อมแล้ว
QIMEN_PAY_ENABLED=false
QIMEN_PRICE_THB=19

# ความลับร่วมกับ gateway สำหรับ webhook ชำระเงิน (ต้องตรงกับ LINE_BOT_NOTIFY_SECRET ที่ gateway)
QIMEN_NOTIFY_SECRET=
